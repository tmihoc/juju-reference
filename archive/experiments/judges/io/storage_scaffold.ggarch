model "Schema" {

  nodes {
    application [type: record, label: "application",
                 ground: "model:application"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        charm_uuid [label: "charm_uuid", type: "text", fk: true]
        charm_modified_version [label: "charm_modified_version", type: "int"]
        charm_upgrade_on_error [label: "charm_upgrade_on_error", type: "bool", null: true]
        space_uuid [label: "space_uuid", type: "text", fk: true]
      }
    }

    architecture [type: record, label: "architecture",
                 ground: "model:architecture"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    block_device [type: record, label: "block_device",
                 ground: "model:block_device"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        machine_uuid [label: "machine_uuid", type: "text", fk: true]
        name [label: "name", type: "text", null: true]
        hardware_id [label: "hardware_id", type: "text", null: true]
        wwn [label: "wwn", type: "text", null: true]
        serial_id [label: "serial_id", type: "text", null: true]
        bus_address [label: "bus_address", type: "text", null: true]
        size_mib [label: "size_mib", type: "int", null: true]
        mount_point [label: "mount_point", type: "text", null: true]
        in_use [label: "in_use", type: "bool", null: true]
        filesystem_label [label: "filesystem_label", type: "text", null: true]
        host_filesystem_uuid [label: "host_filesystem_uuid", type: "text", null: true]
        filesystem_type [label: "filesystem_type", type: "text", null: true]
        provenance_id [label: "provenance_id", type: "int", fk: true]
      }
    }

    block_device_provenance [type: record, label: "block_device_provenance",
                 ground: "model:block_device_provenance"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    charm [type: record, label: "charm",
                 ground: "model:charm"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        archive_path [label: "archive_path", type: "text", null: true]
        object_store_uuid [label: "object_store_uuid", type: "text", fk: true, null: true]
        available [label: "available", type: "bool", null: true]
        version [label: "version", type: "text", null: true]
        lxd_profile [label: "lxd_profile", type: "text", null: true]
        source_id [label: "source_id", type: "int", fk: true]
        revision [label: "revision", type: "int"]
        architecture_id [label: "architecture_id", type: "int", fk: true, null: true]
        reference_name [label: "reference_name", type: "text"]
        create_time [label: "create_time", type: "datetime"]
      }
    }

    charm_source [type: record, label: "charm_source",
                 ground: "model:charm_source"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    life [type: record, label: "life",
                 ground: "model:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    machine [type: record, label: "machine",
                 ground: "model:machine"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        nonce [label: "nonce", type: "text", null: true]
        password_hash_algorithm_id [label: "password_hash_algorithm_id", type: "text", fk: true, null: true]
        password_hash [label: "password_hash", type: "text", null: true]
        force_destroyed [label: "force_destroyed", type: "bool", null: true]
        agent_started_at [label: "agent_started_at", type: "datetime", null: true]
        hostname [label: "hostname", type: "text", null: true]
        keep_instance [label: "keep_instance", type: "bool", null: true]
      }
    }

    net_node [type: record, label: "net_node",
                 ground: "model:net_node"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
      }
    }

    object_store_metadata [type: record, label: "object_store_metadata",
                 ground: "model:object_store_metadata"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        sha_256 [label: "sha_256", type: "text"]
        sha_384 [label: "sha_384", type: "text"]
        size [label: "size", type: "int"]
      }
    }

    password_hash_algorithm [type: record, label: "password_hash_algorithm",
                 ground: "model:password_hash_algorithm"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    space [type: record, label: "space",
                 ground: "model:space"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
      }
    }

    storage_attachment [type: record, label: "storage_attachment",
                 ground: "model:storage_attachment"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        storage_instance_uuid [label: "storage_instance_uuid", type: "text", fk: true]
        unit_uuid [label: "unit_uuid", type: "text", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
      }
    }

    storage_filesystem [type: record, label: "storage_filesystem",
                 ground: "model:storage_filesystem"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        filesystem_id [label: "filesystem_id", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        provision_scope_id [label: "provision_scope_id", type: "int", fk: true]
        provider_id [label: "provider_id", type: "text", null: true]
        size_mib [label: "size_mib", type: "int", null: true]
        obliterate_on_cleanup [label: "obliterate_on_cleanup", type: "bool", null: true]
      }
    }

    storage_filesystem_attachment [type: record, label: "storage_filesystem_attachment",
                 ground: "model:storage_filesystem_attachment"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        storage_filesystem_uuid [label: "storage_filesystem_uuid", type: "text", fk: true]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        provision_scope_id [label: "provision_scope_id", type: "int", fk: true]
        provider_id [label: "provider_id", type: "text", null: true]
        life_id [label: "life_id", type: "int", fk: true]
        mount_point [label: "mount_point", type: "text", null: true]
        read_only [label: "read_only", type: "bool", null: true]
      }
    }

    storage_filesystem_status [type: record, label: "storage_filesystem_status",
                 ground: "model:storage_filesystem_status"] {
      fields {
        filesystem_uuid [label: "filesystem_uuid", type: "text", pk: true, fk: true]
        status_id [label: "status_id", type: "int", fk: true]
        message [label: "message", type: "text", null: true]
        updated_at [label: "updated_at", type: "datetime", null: true]
      }
    }

    storage_filesystem_status_value [type: record, label: "storage_filesystem_status_value",
                 ground: "model:storage_filesystem_status_value"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        status [label: "status", type: "text"]
      }
    }

    storage_instance [type: record, label: "storage_instance",
                 ground: "model:storage_instance"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        charm_name [label: "charm_name", type: "text", null: true]
        storage_name [label: "storage_name", type: "text"]
        storage_kind_id [label: "storage_kind_id", type: "int", fk: true]
        storage_id [label: "storage_id", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        storage_pool_uuid [label: "storage_pool_uuid", type: "text", fk: true]
        requested_size_mib [label: "requested_size_mib", type: "int"]
      }
    }

    storage_instance_filesystem [type: record, label: "storage_instance_filesystem",
                 ground: "model:storage_instance_filesystem"] {
      fields {
        storage_instance_uuid [label: "storage_instance_uuid", type: "text", pk: true, fk: true]
        storage_filesystem_uuid [label: "storage_filesystem_uuid", type: "text", fk: true]
      }
    }

    storage_instance_volume [type: record, label: "storage_instance_volume",
                 ground: "model:storage_instance_volume"] {
      fields {
        storage_instance_uuid [label: "storage_instance_uuid", type: "text", pk: true, fk: true]
        storage_volume_uuid [label: "storage_volume_uuid", type: "text", fk: true]
      }
    }

    storage_kind [type: record, label: "storage_kind",
                 ground: "model:storage_kind"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        kind [label: "kind", type: "text"]
      }
    }

    storage_pool [type: record, label: "storage_pool",
                 ground: "model:storage_pool"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        type [label: "type", type: "text"]
        origin_id [label: "origin_id", type: "int", fk: true]
      }
    }

    storage_pool_attribute [type: record, label: "storage_pool_attribute",
                 ground: "model:storage_pool_attribute"] {
      fields {
        storage_pool_uuid [label: "storage_pool_uuid", type: "text", fk: true]
        value [label: "value", type: "text"]
      }
    }

    storage_pool_origin [type: record, label: "storage_pool_origin",
                 ground: "model:storage_pool_origin"] {
      fields {
        id [label: "id", type: "int", pk: true]
        origin [label: "origin", type: "text"]
      }
    }

    storage_provision_scope [type: record, label: "storage_provision_scope",
                 ground: "model:storage_provision_scope"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        scope [label: "scope", type: "text"]
      }
    }

    storage_unit_owner [type: record, label: "storage_unit_owner",
                 ground: "model:storage_unit_owner"] {
      fields {
        storage_instance_uuid [label: "storage_instance_uuid", type: "text", pk: true, fk: true]
        unit_uuid [label: "unit_uuid", type: "text", fk: true]
      }
    }

    storage_volume [type: record, label: "storage_volume",
                 ground: "model:storage_volume"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        volume_id [label: "volume_id", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        provision_scope_id [label: "provision_scope_id", type: "int", fk: true]
        provider_id [label: "provider_id", type: "text", null: true]
        size_mib [label: "size_mib", type: "int", null: true]
        hardware_id [label: "hardware_id", type: "text", null: true]
        wwn [label: "wwn", type: "text", null: true]
        persistent [label: "persistent", type: "bool", null: true]
        obliterate_on_cleanup [label: "obliterate_on_cleanup", type: "bool", null: true]
      }
    }

    storage_volume_attachment [type: record, label: "storage_volume_attachment",
                 ground: "model:storage_volume_attachment"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        storage_volume_uuid [label: "storage_volume_uuid", type: "text", fk: true]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        provision_scope_id [label: "provision_scope_id", type: "int", fk: true]
        provider_id [label: "provider_id", type: "text", null: true]
        block_device_uuid [label: "block_device_uuid", type: "text", fk: true, null: true]
        read_only [label: "read_only", type: "bool", null: true]
      }
    }

    storage_volume_attachment_plan [type: record, label: "storage_volume_attachment_plan",
                 ground: "model:storage_volume_attachment_plan"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        storage_volume_uuid [label: "storage_volume_uuid", type: "text", fk: true]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        provision_scope_id [label: "provision_scope_id", type: "int", fk: true]
        device_type_id [label: "device_type_id", type: "int", fk: true, null: true]
      }
    }

    storage_volume_attachment_plan_attr [type: record, label: "storage_volume_attachment_plan_attr",
                 ground: "model:storage_volume_attachment_plan_attr"] {
      fields {
        attachment_plan_uuid [label: "attachment_plan_uuid", type: "text", fk: true]
        value [label: "value", type: "text"]
      }
    }

    storage_volume_device_type [type: record, label: "storage_volume_device_type",
                 ground: "model:storage_volume_device_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
        description [label: "description", type: "text", null: true]
      }
    }

    storage_volume_status [type: record, label: "storage_volume_status",
                 ground: "model:storage_volume_status"] {
      fields {
        volume_uuid [label: "volume_uuid", type: "text", pk: true, fk: true]
        status_id [label: "status_id", type: "int", fk: true]
        message [label: "message", type: "text", null: true]
        updated_at [label: "updated_at", type: "datetime", null: true]
      }
    }

    storage_volume_status_value [type: record, label: "storage_volume_status_value",
                 ground: "model:storage_volume_status_value"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        status [label: "status", type: "text"]
      }
    }

    unit [type: record, label: "unit",
                 ground: "model:unit"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        application_uuid [label: "application_uuid", type: "text", fk: true]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        charm_uuid [label: "charm_uuid", type: "text", fk: true]
        password_hash_algorithm_id [label: "password_hash_algorithm_id", type: "text", fk: true, null: true]
        password_hash [label: "password_hash", type: "text", null: true]
      }
    }

  }

  edges {
    application.life_id -> life.id [type: data]
    application.charm_uuid -> charm.uuid [type: data]
    application.space_uuid -> space.uuid [type: data]
    block_device.machine_uuid -> machine.uuid [type: data]
    block_device.provenance_id -> block_device_provenance.id [type: data]
    charm.source_id -> charm_source.id [type: data]
    charm.architecture_id -> architecture.id [type: data]
    charm.object_store_uuid -> object_store_metadata.uuid [type: data]
    machine.net_node_uuid -> net_node.uuid [type: data]
    machine.life_id -> life.id [type: data]
    machine.password_hash_algorithm_id -> password_hash_algorithm.id [type: data]
    storage_attachment.storage_instance_uuid -> storage_instance.uuid [type: data]
    storage_attachment.unit_uuid -> unit.uuid [type: data]
    storage_attachment.life_id -> life.id [type: data]
    storage_filesystem.life_id -> life.id [type: data]
    storage_filesystem.provision_scope_id -> storage_provision_scope.id [type: data]
    storage_filesystem_attachment.storage_filesystem_uuid -> storage_filesystem.uuid [type: data]
    storage_filesystem_attachment.net_node_uuid -> net_node.uuid [type: data]
    storage_filesystem_attachment.life_id -> life.id [type: data]
    storage_filesystem_attachment.provision_scope_id -> storage_provision_scope.id [type: data]
    storage_filesystem_status.filesystem_uuid -> storage_filesystem.uuid [type: data]
    storage_filesystem_status.status_id -> storage_filesystem_status_value.id [type: data]
    storage_instance.storage_kind_id -> storage_kind.id [type: data]
    storage_instance.life_id -> life.id [type: data]
    storage_instance.storage_pool_uuid -> storage_pool.uuid [type: data]
    storage_instance_filesystem.storage_instance_uuid -> storage_instance.uuid [type: data]
    storage_instance_filesystem.storage_filesystem_uuid -> storage_filesystem.uuid [type: data]
    storage_instance_volume.storage_instance_uuid -> storage_instance.uuid [type: data]
    storage_instance_volume.storage_volume_uuid -> storage_volume.uuid [type: data]
    storage_pool.origin_id -> storage_pool_origin.id [type: data]
    storage_pool_attribute.storage_pool_uuid -> storage_pool.uuid [type: data]
    storage_unit_owner.storage_instance_uuid -> storage_instance.uuid [type: data]
    storage_unit_owner.unit_uuid -> unit.uuid [type: data]
    storage_volume.life_id -> life.id [type: data]
    storage_volume.provision_scope_id -> storage_provision_scope.id [type: data]
    storage_volume_attachment.storage_volume_uuid -> storage_volume.uuid [type: data]
    storage_volume_attachment.net_node_uuid -> net_node.uuid [type: data]
    storage_volume_attachment.life_id -> life.id [type: data]
    storage_volume_attachment.block_device_uuid -> block_device.uuid [type: data]
    storage_volume_attachment.provision_scope_id -> storage_provision_scope.id [type: data]
    storage_volume_attachment_plan.storage_volume_uuid -> storage_volume.uuid [type: data]
    storage_volume_attachment_plan.net_node_uuid -> net_node.uuid [type: data]
    storage_volume_attachment_plan.life_id -> life.id [type: data]
    storage_volume_attachment_plan.device_type_id -> storage_volume_device_type.id [type: data]
    storage_volume_attachment_plan.provision_scope_id -> storage_provision_scope.id [type: data]
    storage_volume_attachment_plan_attr.attachment_plan_uuid -> storage_volume_attachment_plan.uuid [type: data]
    storage_volume_status.volume_uuid -> storage_volume.uuid [type: data]
    storage_volume_status.status_id -> storage_volume_status_value.id [type: data]
    unit.life_id -> life.id [type: data]
    unit.application_uuid -> application.uuid [type: data]
    unit.net_node_uuid -> net_node.uuid [type: data]
    unit.charm_uuid -> charm.uuid [type: data]
    unit.password_hash_algorithm_id -> password_hash_algorithm.id [type: data]
  }

  style { extends: juju }

}
