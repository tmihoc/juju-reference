model "Schema" {

  nodes {
    application [type: record, label: "application",
                 ground: "model:application"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        charm_uuid [label: "charm_uuid", type: "text", fk: true]
        charm_modified_version [label: "charm_modified_version", type: "int"]
        charm_upgrade_on_error [label: "charm_upgrade_on_error", type: "bool", null: true]
        space_uuid [label: "space_uuid", type: "text", fk: true]
      }
    }

    architecture [type: record, label: "architecture",
                 ground: "model:architecture"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    charm [type: record, label: "charm",
                 ground: "model:charm"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        archive_path [label: "archive_path", type: "text", null: true]
        object_store_uuid [label: "object_store_uuid", type: "text", fk: true, null: true]
        available [label: "available", type: "bool", null: true]
        version [label: "version", type: "text", null: true]
        lxd_profile [label: "lxd_profile", type: "text", null: true]
        source_id [label: "source_id", type: "int", fk: true]
        revision [label: "revision", type: "int"]
        architecture_id [label: "architecture_id", type: "int", fk: true, null: true]
        reference_name [label: "reference_name", type: "text"]
        create_time [label: "create_time", type: "datetime"]
      }
    }

    charm_source [type: record, label: "charm_source",
                 ground: "model:charm_source"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    life [type: record, label: "life",
                 ground: "model:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    net_node [type: record, label: "net_node",
                 ground: "model:net_node"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
      }
    }

    object_store_metadata [type: record, label: "object_store_metadata",
                 ground: "model:object_store_metadata"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        sha_256 [label: "sha_256", type: "text"]
        sha_384 [label: "sha_384", type: "text"]
        size [label: "size", type: "int"]
      }
    }

    password_hash_algorithm [type: record, label: "password_hash_algorithm",
                 ground: "model:password_hash_algorithm"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    secret [type: record, label: "secret",
                 ground: "model:secret"] {
      fields {
        id [label: "id", type: "text", pk: true]
      }
    }

    secret_application_owner [type: record, label: "secret_application_owner",
                 ground: "model:secret_application_owner"] {
      fields {
        secret_id [label: "secret_id", type: "text", fk: true]
        application_uuid [label: "application_uuid", type: "text", fk: true]
        label [label: "label", type: "text", null: true]
      }
    }

    secret_content [type: record, label: "secret_content",
                 ground: "model:secret_content"] {
      fields {
        revision_uuid [label: "revision_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        content [label: "content", type: "text"]
      }
    }

    secret_deleted_value_ref [type: record, label: "secret_deleted_value_ref",
                 ground: "model:secret_deleted_value_ref"] {
      fields {
        revision_uuid [label: "revision_uuid", type: "text", pk: true]
        backend_uuid [label: "backend_uuid", type: "text"]
        revision_id [label: "revision_id", type: "text"]
      }
    }

    secret_grant_scope_type [type: record, label: "secret_grant_scope_type",
                 ground: "model:secret_grant_scope_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text", null: true]
      }
    }

    secret_grant_subject_type [type: record, label: "secret_grant_subject_type",
                 ground: "model:secret_grant_subject_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text", null: true]
      }
    }

    secret_metadata [type: record, label: "secret_metadata",
                 ground: "model:secret_metadata"] {
      fields {
        secret_id [label: "secret_id", type: "text", pk: true, fk: true]
        version [label: "version", type: "int"]
        description [label: "description", type: "text", null: true]
        rotate_policy_id [label: "rotate_policy_id", type: "int", fk: true]
        auto_prune [label: "auto_prune", type: "bool"]
        latest_revision_checksum [label: "latest_revision_checksum", type: "text", null: true]
        create_time [label: "create_time", type: "datetime"]
        update_time [label: "update_time", type: "datetime"]
      }
    }

    secret_model_owner [type: record, label: "secret_model_owner",
                 ground: "model:secret_model_owner"] {
      fields {
        secret_id [label: "secret_id", type: "text", pk: true, fk: true]
        label [label: "label", type: "text", null: true]
      }
    }

    secret_permission [type: record, label: "secret_permission",
                 ground: "model:secret_permission"] {
      fields {
        secret_id [label: "secret_id", type: "text", fk: true]
        role_id [label: "role_id", type: "int", fk: true]
        subject_uuid [label: "subject_uuid", type: "text"]
        subject_type_id [label: "subject_type_id", type: "int", fk: true]
        scope_uuid [label: "scope_uuid", type: "text"]
        scope_type_id [label: "scope_type_id", type: "text", fk: true]
      }
    }

    secret_reference [type: record, label: "secret_reference",
                 ground: "model:secret_reference"] {
      fields {
        secret_id [label: "secret_id", type: "text", pk: true, fk: true]
        latest_revision [label: "latest_revision", type: "int"]
        owner_application_uuid [label: "owner_application_uuid", type: "text", fk: true, null: true]
        updated_at [label: "updated_at", type: "datetime"]
        migrated [label: "migrated", type: "bool"]
      }
    }

    secret_remote_unit_consumer [type: record, label: "secret_remote_unit_consumer",
                 ground: "model:secret_remote_unit_consumer"] {
      fields {
        secret_id [label: "secret_id", type: "text", fk: true]
        unit_name [label: "unit_name", type: "text"]
        current_revision [label: "current_revision", type: "int"]
      }
    }

    secret_reservation [type: record, label: "secret_reservation",
                 ground: "model:secret_reservation"] {
      fields {
        secret_id [label: "secret_id", type: "text", pk: true]
        unit_uuid [label: "unit_uuid", type: "text", fk: true]
        created_at [label: "created_at", type: "timestamp"]
      }
    }

    secret_revision [type: record, label: "secret_revision",
                 ground: "model:secret_revision"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        secret_id [label: "secret_id", type: "text", fk: true]
        revision [label: "revision", type: "int"]
        create_time [label: "create_time", type: "datetime"]
        update_time [label: "update_time", type: "datetime"]
      }
    }

    secret_revision_expire [type: record, label: "secret_revision_expire",
                 ground: "model:secret_revision_expire"] {
      fields {
        revision_uuid [label: "revision_uuid", type: "text", pk: true, fk: true]
        expire_time [label: "expire_time", type: "datetime"]
      }
    }

    secret_revision_obsolete [type: record, label: "secret_revision_obsolete",
                 ground: "model:secret_revision_obsolete"] {
      fields {
        revision_uuid [label: "revision_uuid", type: "text", pk: true, fk: true]
        obsolete [label: "obsolete", type: "bool"]
        pending_delete [label: "pending_delete", type: "bool"]
      }
    }

    secret_role [type: record, label: "secret_role",
                 ground: "model:secret_role"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        role [label: "role", type: "text", null: true]
      }
    }

    secret_rotate_policy [type: record, label: "secret_rotate_policy",
                 ground: "model:secret_rotate_policy"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        policy [label: "policy", type: "text"]
      }
    }

    secret_rotation [type: record, label: "secret_rotation",
                 ground: "model:secret_rotation"] {
      fields {
        secret_id [label: "secret_id", type: "text", pk: true, fk: true]
        next_rotation_time [label: "next_rotation_time", type: "datetime"]
      }
    }

    secret_unit_consumer [type: record, label: "secret_unit_consumer",
                 ground: "model:secret_unit_consumer"] {
      fields {
        secret_id [label: "secret_id", type: "text", fk: true]
        source_model_uuid [label: "source_model_uuid", type: "text"]
        unit_uuid [label: "unit_uuid", type: "text", fk: true]
        label [label: "label", type: "text", null: true]
        current_revision [label: "current_revision", type: "int"]
      }
    }

    secret_unit_owner [type: record, label: "secret_unit_owner",
                 ground: "model:secret_unit_owner"] {
      fields {
        secret_id [label: "secret_id", type: "text", fk: true]
        unit_uuid [label: "unit_uuid", type: "text", fk: true]
        label [label: "label", type: "text", null: true]
      }
    }

    secret_value_ref [type: record, label: "secret_value_ref",
                 ground: "model:secret_value_ref"] {
      fields {
        revision_uuid [label: "revision_uuid", type: "text", pk: true, fk: true]
        backend_uuid [label: "backend_uuid", type: "text"]
        revision_id [label: "revision_id", type: "text"]
      }
    }

    space [type: record, label: "space",
                 ground: "model:space"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
      }
    }

    unit [type: record, label: "unit",
                 ground: "model:unit"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        application_uuid [label: "application_uuid", type: "text", fk: true]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        charm_uuid [label: "charm_uuid", type: "text", fk: true]
        password_hash_algorithm_id [label: "password_hash_algorithm_id", type: "text", fk: true, null: true]
        password_hash [label: "password_hash", type: "text", null: true]
      }
    }

  }

  edges {
    application.life_id -> life.id [type: data]
    application.charm_uuid -> charm.uuid [type: data]
    application.space_uuid -> space.uuid [type: data]
    charm.source_id -> charm_source.id [type: data]
    charm.architecture_id -> architecture.id [type: data]
    charm.object_store_uuid -> object_store_metadata.uuid [type: data]
    secret_application_owner.secret_id -> secret_metadata.secret_id [type: data]
    secret_application_owner.application_uuid -> application.uuid [type: data]
    secret_content.revision_uuid -> secret_revision.uuid [type: data]
    secret_metadata.secret_id -> secret.id [type: data]
    secret_metadata.rotate_policy_id -> secret_rotate_policy.id [type: data]
    secret_model_owner.secret_id -> secret_metadata.secret_id [type: data]
    secret_permission.secret_id -> secret_metadata.secret_id [type: data]
    secret_permission.role_id -> secret_role.id [type: data]
    secret_permission.subject_type_id -> secret_grant_subject_type.id [type: data]
    secret_permission.scope_type_id -> secret_grant_scope_type.id [type: data]
    secret_reference.secret_id -> secret.id [type: data]
    secret_reference.owner_application_uuid -> application.uuid [type: data]
    secret_remote_unit_consumer.secret_id -> secret_metadata.secret_id [type: data]
    secret_reservation.unit_uuid -> unit.uuid [type: data]
    secret_revision.secret_id -> secret_metadata.secret_id [type: data]
    secret_revision_expire.revision_uuid -> secret_revision.uuid [type: data]
    secret_revision_obsolete.revision_uuid -> secret_revision.uuid [type: data]
    secret_rotation.secret_id -> secret_metadata.secret_id [type: data]
    secret_unit_consumer.unit_uuid -> unit.uuid [type: data]
    secret_unit_consumer.secret_id -> secret.id [type: data]
    secret_unit_owner.secret_id -> secret_metadata.secret_id [type: data]
    secret_unit_owner.unit_uuid -> unit.uuid [type: data]
    secret_value_ref.revision_uuid -> secret_revision.uuid [type: data]
    unit.life_id -> life.id [type: data]
    unit.application_uuid -> application.uuid [type: data]
    unit.net_node_uuid -> net_node.uuid [type: data]
    unit.charm_uuid -> charm.uuid [type: data]
    unit.password_hash_algorithm_id -> password_hash_algorithm.id [type: data]
  }

  style { extends: juju }

}
