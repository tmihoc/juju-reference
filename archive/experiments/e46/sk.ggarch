      fields {
        uuid [label: "uuid", type: "text", pk: true]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        endpoint [label: "endpoint", type: "text", null: true]
        identity_endpoint [label: "identity_endpoint", type: "text", null: true]
        storage_endpoint [label: "storage_endpoint", type: "text", null: true]
      }
    }

    cloud_type [type: record, label: "cloud_type",
                 ground: "controller:cloud_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text"]
      }
    }

    life [type: record, label: "life",
                 ground: "controller:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    model [type: record, label: "model",
                 ground: "controller:model"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        activated [label: "activated", type: "bool"]
