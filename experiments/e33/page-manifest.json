  "application_remote_offerer_relation_macaroon": "(E33 audit)",
  "application_remote_offerer_status": "(E33 audit)",
  "application_resource": "link table between application and resource (E33 audit)",
  "application_storage_directive": "storage directives are documented with storage; judge M1 and the existing storage page agree (E34 M1)",
  "availability_zone": "own page upstream (E33 audit)",
  "availability_zone_subnet": "(E33 audit)",
  "bakery_config": "macaroon bakery keys of the controller; no foreign key to a user (E34 M2, verified)",
  "block_command": "a guard, not a device (E33 audit)",
  "block_device": "a machine's disk inventory, foreign key machine (E34 M2, verified); storage points to it",
  "block_device_link_device": "(same reason)",
  "charm_tracing_config": "controller tracing configuration, not a charm fact",
  "cloud_credential": "own domain and facade (E33 audit)",
  "cloud_credential_attribute": "(E33 audit)",
  "cloud_defaults": "model defaults noun (E33 audit)",
  "cloud_image_metadata": "own domain (E33 audit)",
  "cloud_region_defaults": "(E33 audit)",
  "constraint_space": "(constraint facet)",
  "controller_config": "(configuration of the controller)",
